{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "valentin-mail",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Le webmail (page, styles, script) est servi tel quel depuis ./public.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Index des messages.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valentin-mail",
      "database_id": "451c31ce-6e38-4c5f-9616-7479729a8ac9"
    }
  ],

  // Messages bruts (.eml), pièces jointes comprises.
  "r2_buckets": [{ "binding": "MAIL_BUCKET", "bucket_name": "valentin-mail-raw" }],

  // Adresse d'expédition, telle que tes correspondants la verront.
  "vars": { "MAIL_FROM": "Valentin <valentin@valentinlarge.com>" },

  // Quelles adresses arrivent dans la boîte : cela se règle dans le tableau de bord Cloudflare
  // (Email Routing > Routing Rules), par une règle par adresse ou par la règle « Catch-all »
  // avec l'action « Send to a Worker ». La déclarer ici ("addresses": ["*@valentinlarge.com"])
  // fait échouer le déploiement automatique : il n'a pas le droit de toucher à ces règles.

  // Pour ouvrir le webmail sur ton domaine plutôt que sur l'adresse *.workers.dev,
  // retire les deux barres devant la ligne suivante :
  // "routes": [{ "pattern": "courrier.valentinlarge.com", "custom_domain": true }],

  // Entretien de fond : chaque minute, le serveur indexe et inventorie seul quelques messages en retard
  // (fonction « scheduled » du Worker). Sans retard à rattraper, un passage ne coûte presque rien.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
